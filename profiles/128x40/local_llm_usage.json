{
  "$schema": "../.schema/config.schema.json",
  "config_name": "Local LLM Usage",
  "refresh_rate_ms": 500,
  "display": {
    "width": 128,
    "height": 40,
    "background": 0
  },
  "widgets": [
    {
      "type": "memory",
      "enabled": true,
      "position": {
        "x": 0,
        "y": 0,
        "w": 128,
        "h": 20,
        "z": 0
      },
      "style": {
        "background": 0,
        "border": -1,
        "padding": 0
      },
      "mode": "text",
      "text": {
        "format": "R {used}GB {percent}%",
        "font": null,
        "size": 18,
        "align": {
          "h": "center",
          "v": "center"
        }
      },
      "update_interval": 0.5
    },
    {
      "type": "gpu",
      "enabled": true,
      "position": {
        "x": 0,
        "y": 20,
        "w": 128,
        "h": 20,
        "z": 0
      },
      "style": {
        "background": 0,
        "border": -1,
        "padding": 0
      },
      "mode": "text",
      "gpu": {
        "adapter": 0,
        "metric": "memory_dedicated"
      },
      "text": {
        "format": "V {used}GB {percent}%",
        "size": 18,
        "align": {
          "h": "center",
          "v": "center"
        }
      },
      "update_interval": 0.5
    }
  ]
}
